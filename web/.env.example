# Copy to .env.local and adjust. Every VITE_* value is read once in src/config.ts.

# Where Vite's dev server forwards /v1 calls (the FastAPI app).
GEOSEARCH_API_PROXY_TARGET=http://localhost:8000

# API base URL as seen by the browser. Empty = same origin (dev proxy or a
# reverse proxy in production). Set it only if the API is served elsewhere
# with CORS enabled.
VITE_API_BASE_URL=

# How long to wait for one agent turn before giving up, in seconds. A local
# model can take minutes.
VITE_REQUEST_TIMEOUT_S=600

# Client-side mirrors of the backend limits (GEOSEARCH_LIMITS__*). They only
# give early feedback; the backend still decides.
VITE_MAX_AREA_KM2=100
VITE_MAX_PROMPT_CHARS=2000

# Basemaps, in the order the "base map" button cycles through them. JSON list of
# { id, label, url, attribution, maxZoom?, subdomains?, darkUrl?, darkFilter? }.
# In dark mode a basemap uses darkUrl if set; otherwise its tiles are inverted
# with a CSS filter, unless darkFilter is false (use that for imagery). Empty = built-in defaults
# (OpenStreetMap, then Esri satellite imagery).
VITE_BASEMAPS=

# Place search on the map: "nominatim" (OpenStreetMap, no key) or "none".
VITE_GEOCODER=nominatim
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Initial map view: "lat,lon,zoom".
VITE_MAP_INITIAL_VIEW=32.0853,34.7818,13
